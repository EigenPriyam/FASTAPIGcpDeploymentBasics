DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/linkrot
# Cloud SQL (Cloud Run): postgresql+asyncpg://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
# Used by docker-compose to create the local Postgres; keep in sync with DATABASE_URL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=linkrot
PORT=8000
LOG_LEVEL=INFO
CHECK_TIMEOUT_SECONDS=10
MAX_CONCURRENCY=10

